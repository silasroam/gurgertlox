# ============================================================
# Vercel Environment Variables (Dashboard -> Settings -> Env Vars)
# ============================================================

# --- Облачная PostgreSQL (одна из двух строк) ---
# Neon (рекомендуется для serverless): Dashboard -> Connection String
POSTGRES_URL=postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Vercel Postgres / Supabase / любой TCP-постгрес:
# DATABASE_URL=postgres://...?sslmode=require

# --- Telegram ---
# Токен бота Мини-приложения (HMAC-SHA256 валидация initData).
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# Опционально: сид-баланс новым юзерам для тестов (0 = production).
SEED_BALANCE_STARS=0

# Строгая авторизация: true = без валидного initData доступ запрещён.
# false — только для локальной разработки (dev passthrough).
REQUIRE_TG_AUTH=true

# --- Админ-доступ (выдача игровых звёзд) ---
# Секретный ключ для POST /api/admin/grant и CLI server/grant.cjs.
# Обязательно задайте случайное значение (openssl rand -hex 24).
ADMIN_SECRET=YOUR_STRONG_RANDOM_SECRET

# --- Крипто-депозиты (Exodus, без KYC) ---
# Секрет cron-воркера /api/cron/crypto-deposits (Authorization: Bearer).
CRON_SECRET=YOUR_STRONG_RANDOM_SECRET
# Ставки: звёзд за 1 единицу крипты (JSON).
CRYPTO_RATES={"USDT_TRC20":100,"TON":450,"LTC":8000}
# Подтверждения сети и погрешность суммы.
CRYPTO_MIN_CONFIRMS=1
CRYPTO_AMOUNT_TOLERANCE=0.99
# Адреса кошельков (переопределяют дефолты).
WALLET_USDT_TRC20=TWq6JByvRy4S1KrJze7krqpfhUb7pbK7oR
WALLET_TON=UQDbde4KnNiqjiWkx4IhsB5ChhVlKWtY6DSAyZzZ-G0mM6k7
WALLET_LTC=LaoDjKGe3NMdTLFQEt1ifVyHXcFXZ2wSF9
