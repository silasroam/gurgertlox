# ============================================================
# Vercel Environment Variables (Dashboard -> Settings -> Env Vars)
# ============================================================

# --- Облачная PostgreSQL (одна из двух строк) ---
# Neon (рекомендуется для serverless): Dashboard -> Connection String
POSTGRES_URL=postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Vercel Postgres / Supabase / любой TCP-постгрес:
# DATABASE_URL=postgres://...?sslmode=require

# --- Telegram ---
# Токен бота Мини-приложения (HMAC-SHA256 валидация initData).
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# Опционально: сид-баланс новым юзерам для тестов (0 = production).
SEED_BALANCE_STARS=0

# Строгая авторизация: true = без валидного initData доступ запрещён.
# false — только для локальной разработки (dev passthrough).
REQUIRE_TG_AUTH=true
